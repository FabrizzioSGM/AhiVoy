# ═══════════════════════════════════════════════════════════════════════════════
# ZzingRush — Variables de Entorno
# ═══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env.local y llena los valores reales.
# NUNCA subas .env.local al repositorio.
# Este archivo (.env.example) SÍ se sube — es la guía de configuración.
# ═══════════════════════════════════════════════════════════════════════════════


# ── App ──────────────────────────────────────────────────────────────────────
# URL pública de tu aplicación (sin slash al final)
# - Local: http://localhost:3000
# - Producción: https://zzingrush.com
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Supabase ─────────────────────────────────────────────────────────────────
# Crea tu proyecto en https://supabase.com → Settings → API
#
# URL pública del proyecto (safe para el frontend)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
#
# Anon key: permisos limitados por RLS, safe para el frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Service Role key: permisos de admin, SOLO en servidor (nunca NEXT_PUBLIC_)
# Úsala en API routes y server actions únicamente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── Stripe ───────────────────────────────────────────────────────────────────
# Crea tu cuenta en https://stripe.com → Developers → API Keys
# Usa claves de TEST para desarrollo, LIVE para producción
#
# Publishable key: safe para el frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Secret key: SOLO servidor
STRIPE_SECRET_KEY=sk_test_...
#
# Webhook secret: se genera en https://stripe.com → Developers → Webhooks
# Local: instala stripe-cli y corre `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...
#
# ID del producto/precio en Stripe para la comisión de la plataforma
STRIPE_PLATFORM_FEE_PERCENT=5


# ── Google Maps ──────────────────────────────────────────────────────────────
# Crea tu API Key en https://console.cloud.google.com → APIs & Services
# Habilita: Maps JavaScript API, Directions API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...


# ── Email transaccional (Resend) ─────────────────────────────────────────────
# Crea tu cuenta en https://resend.com → API Keys
# Configura tu dominio (zzingrush.mx) en Resend para evitar spam
RESEND_API_KEY=re_...
# Dirección desde la que se envían los correos
EMAIL_FROM=notificaciones@zzingrush.mx


# ── SMS / WhatsApp (Twilio) ───────────────────────────────────────────────────
# Crea tu cuenta en https://twilio.com → Console
# Usado para notificaciones SMS a transportistas
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15005550006


# ── CFDI / Facturación (Facturama) ───────────────────────────────────────────
# Crea tu cuenta en https://facturama.mx
# Sandbox disponible en https://apisandbox.facturama.mx
FACTURAMA_USER=tu_usuario_facturama
FACTURAMA_PASSWORD=tu_password_facturama
# Cambia a false en producción
FACTURAMA_SANDBOX=true


# ── IA — Google Gemini ───────────────────────────────────────────────────────
# Obtén tu API key GRATIS en https://aistudio.google.com/apikey
# Tier gratuito: 1,500 llamadas/día — suficiente para un MVP
# SOLO servidor — nunca NEXT_PUBLIC_
GEMINI_API_KEY=AIza...


# ── Seguridad / JWT ──────────────────────────────────────────────────────────
# String aleatorio de mínimo 32 caracteres para firmar tokens internos
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia_esto_por_un_string_aleatorio_seguro_de_32_chars
